{
  "name": "@4fu/dsh-arbor-fonts",
  "version": "2026.1110.0",
  "type": "module",
  "description": "A DeepSeek Harness client plugin that sets the fonts of the Arbor page through its typography contract, and does nothing on ordinary pages",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "client.js",
    "fonts",
    "LICENSE",
    "NOTICE",
    "README.md"
  ],
  "dsh": {
    "client": {
      "platform": "web",
      "inject": []
    }
  },
  "scripts": {
    "build": "node scripts/write-font-manifest.mjs && node build.mjs && tsc -p tsconfig.build.json && node ../../scripts/rewrite-declarations.mjs"
  },
  "devDependencies": {
    "esbuild": "0.28.2"
  },
  "license": "MIT AND OFL-1.1",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/4fuu/dsh-arbor-fonts.git",
    "directory": "packages/dsh-arbor-fonts"
  },
  "engines": {
    "node": ">=24.9.0",
    "dsh": "0.2.2-rc.1"
  },
  "publishConfig": {
    "access": "public"
  },
  "types": "./lib/index.d.ts",
  "main": "./lib/index.js"
}
